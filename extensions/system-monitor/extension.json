{
  "id": "system-monitor",
  "name": "System Monitor",
  "description": "Inline titlebar system monitor with curved bars for CPU, RAM, Disk, IO, and Network. Click to expand with braille wave history. Configurable settings panel.",
  "version": "0.8.1",
  "author": "chonsong",
  "assets": {
    "scripts": ["assets/monitor.js"],
    "stylesheets": ["assets/monitor.css"]
  },
  "capabilities": ["manifest-bundle"],
  "lifecycle": {
    "webui_restart_required": false,
    "sidecar_start_required": false,
    "native_host_start_required": false,
    "native_host_autostart": "none"
  },
  "screenshots": [],
  "permissions": {
    "webui_api": { "read": [], "write": [] },
    "webui_navigation": false,
    "dom": { "owned": true, "mutates_core_views": true },
    "storage": { "owned": true, "shared_webui_keys": [] },
    "loopback_sidecar": false,
    "native_host": false,
    "filesystem": { "arbitrary": false, "serves_bundled_assets": true },
    "network_external": false
  }
}

{
  "extensions": [
    {
      "id": "chat-tiling",
      "name": "Chat Tiling",
      "description": "Compare saved conversation history in snapshot grids. Open a snapshot in Core normal chat, using the sole existing composer. Closing a snapshot only removes its local display.",
      "version": "1.0.0",
      "author": "ChonSong",
      "homepage": "https://github.com/ChonSong/hermes-webui",
      "scripts": [
        "assets/tiling.js"
      ],
      "stylesheets": [],
      "capabilities": [
        "manifest-bundle"
      ],
      "permissions": {
        "dom": {
          "owned": true,
          "mutates_core_views": true
        },
        "storage": {
          "owned": [],
          "shared_webui_keys": [
            "hermes-webui-sidebar-collapsed",
            "hermes-media-playback-rate"
          ]
        },
        "webui_api": {
          "read": [
            "session",
            "media"
          ],
          "write": []
        },
        "webui_navigation": true,
        "network_external": true,
        "filesystem": {
          "arbitrary": false,
          "serves_bundled_assets": true
        },
        "loopback_sidecar": false,
        "native_host": false
      },
      "lifecycle": {
        "webui_restart_required": false,
        "sidecar_start_required": false,
        "native_host_start_required": false,
        "native_host_autostart": "none"
      }
    }
  ]
}

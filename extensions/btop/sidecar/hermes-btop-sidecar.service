# btop sidecar — token-v1 loopback backend for the btop WebUI extension.
# Reads /proc and /sys and serves snapshots on 127.0.0.1:17797. WebUI provisions
# the proxy token in its state dir; the scaffold resolves it. No token in this unit.
#
# Run it as the same user as Hermes WebUI (the token file is that user's, 0600):
#   mkdir -p ~/.config/systemd/user
#   cp ~/.hermes/webui/extensions/btop/sidecar/hermes-btop-sidecar.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hermes-btop-sidecar
#   loginctl enable-linger "$USER"     # optional: keep it running without a login session
# Signals act with this user's privileges. To turn them off:
#   systemctl --user edit hermes-btop-sidecar   ->   [Service]  Environment=BTOP_SIGNALS=0
[Unit]
Description=btop sidecar (system monitor backend for the btop WebUI extension, token-v1)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/webui/extensions/btop/sidecar
Environment=HERMES_WEBUI_STATE_DIR=%h/.hermes/webui
ExecStart=/usr/bin/python3 -S -u sidecar.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
